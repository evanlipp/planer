NODE_ENV=production
PORT=3000
# Replace with the exact deployed frontend origin. Multiple origins are comma-separated.
FRONTEND_ORIGINS=https://your-project.vercel.app
# Use a managed production MongoDB URI; do not commit its credentials.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/planer
# Generate a unique random value of at least 32 characters and store it in the host's secret manager.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional one-time user creation. Both values must be present together.
# The password is hashed and is never logged. Removing these after the first deploy is safe.
INITIAL_USERNAME=admin
INITIAL_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
